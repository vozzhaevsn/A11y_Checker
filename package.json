{
  "name": "a11y-checker-pro",
  "version": "1.0.0",
  "description": "Browser extension for automated accessibility checking based on WCAG standards",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development --watch",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "start": "npm run build:dev",
    "clean": "rm -rf dist",
    "prepare": "husky"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "a11y",
    "browser-extension",
    "chrome-extension"
  ],
  "author": "Semyon Vozzhaev",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axe-core": "^4.8.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.250",
    "@types/jest": "^29.0.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.4",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.0.5",
    "mini-css-extract-plugin": "^2.9.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "typescript": "^5.0.0",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.107.1",
    "webpack-cli": "^5.0.0"
  }
}
